{
  "rules": [
    {
      "rule_id": "RULE_HARDCODED_ORACLE_OR_ECONOMIC_INPUT",
      "title": "Hardcoded Oracle Price, Index or Economic Input",
      "pattern": "1000\\s*\\*\\s*1e8|100_000_000|1000000\\s*\\*\\s*PRECISION",
      "description": "Hardcoded economic values or oracle price returns bypass dynamic oracle/config inputs."
    },
    {
      "rule_id": "RULE_UNVALIDATED_CROSS_CHAIN_SOURCE_OR_NONCE",
      "title": "Unvalidated Source Address or Nonce Binding in Cross-Chain Messaging",
      "pattern": "retryMessage|_validateMessage",
      "description": "Cross-chain message handlers that accept srcAddress or transport nonce without binding/validating them."
    },
    {
      "rule_id": "RULE_IGNORED_MARKET_OR_POSITION_PARAMETER",
      "title": "Ignored Market or Position ID in Risk/Oracle Calculations",
      "pattern": "function\\s+(_getConcentrationLimit|getTWAP|getTWAFundingRate|_getOraclePrice)\\s*\\(",
      "description": "Functions taking positionId, marketId, or period parameter but ignoring it in state lookup."
    },
    {
      "rule_id": "RULE_UNIMPLEMENTED_CRITICAL_TIMELOCK_CHECK",
      "title": "Unimplemented or Dummy Governance / Timelock Safety Check",
      "pattern": "function\\s+_isCriticalOperation",
      "description": "Critical operation checks in timelocks returning false or dummy hardcoded values."
    },
    {
      "rule_id": "RULE_DISABLED_EMERGENCY_OR_ADMIN_CONTROL",
      "title": "Exposed Emergency / Admin Control Function Always Reverting",
      "pattern": "revert\\(\\\"[^\\\"]*disabled\\\"|revert\\(\\\"[^\\\"]*not implemented\\\"",
      "description": "Exposed state management or emergency control APIs that always revert."
    },
    {
      "rule_id": "RULE_RAW_ETH_TRANSFER_REENTRANCY_OR_ORDERING",
      "title": "Uncapped Raw ETH Transfer Prior to State Deletion / Reentrancy",
      "pattern": "\\.call\\s*\\{value:[^}]*\\}\\s*\\(\\\"\\\"\\)",
      "description": "Raw ETH calls before state cleanup or lacking reentrancy guards."
    },
    {
      "rule_id": "RULE_UNCHECKED_EXTERNAL_TOKEN_CALL",
      "title": "Unchecked Return Value on External Token Transfer",
      "pattern": "\\.transferFrom\\(|\\.transfer\\(",
      "description": "Calls to transfer or transferFrom whose boolean return value is unchecked."
    },
    {
      "rule_id": "RULE_UNOBSERVABLE_AUTHORITY_ROTATION",
      "title": "Authority or Role Setter Lacking Event Emission",
      "pattern": "function\\s+set[A-Z0-9_]+\\s*\\([^)]*\\)[^{]*\\{",
      "description": "Critical governance or authority setters that modify storage without emitting an event."
    },
    {
      "rule_id": "RULE_SETTER_NO_STATE_MUTATION",
      "title": "Config/Incentive Setter with Input Validation but No Storage Mutation",
      "pattern": "function\\s+set[A-Z0-9_]+\\s*\\(",
      "description": "Setter functions that validate input parameters but fail to write to storage."
    },
    {
      "rule_id": "RULE_TYPE_NARROWING_TRUNCATION",
      "title": "Unchecked Narrowing Integer Cast or Decimal Conversion",
      "pattern": "uint16\\(|uint64\\(|int128\\(",
      "description": "Narrowing typecasts (e.g. block.chainid to uint16) without range checks."
    }
  ],
