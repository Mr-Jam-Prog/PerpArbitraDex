{
    "name": "perp-arbitra-dex",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.4.0",
    "engines": {
        "node": "24.21.0",
        "pnpm": "12.4.0"
    },
    "workspaces": [
        "frontend",
        "packages/*",
        "bots/*",
        "monitoring"
    ],
    "scripts": {
        "install:frozen": "pnpm install --frozen-lockfile",
        "compile:hardhat": "pnpm exec hardhat compile",
        "compile:forge": "forge build",
        "compile": "pnpm run compile:hardhat && pnpm run compile:forge",
        "test:unit": "pnpm exec hardhat test --no-compile test/unit/*.test.js",
        "test:forge": "forge test --offline --summary",
        "check:contract-size": "node scripts/check-contract-size.mjs",
        "check:warning-baseline": "node scripts/check-warning-baseline.mjs",
        "test:math": "pnpm --filter @perpdex/math test",
        "build:packages": "pnpm --filter @perpdex/math run build && pnpm --filter @perpdex/sdk run build",
        "check:core": "pnpm run install:frozen && pnpm run compile:hardhat && pnpm run check:contract-size && pnpm run check:warning-baseline && pnpm run compile:forge && pnpm run test:unit && pnpm run test:forge && pnpm run build:packages && pnpm run test:math",
        "build": "pnpm --recursive run build",
        "lint": "pnpm --recursive run lint"
    },
    "description": "",
    "main": ".eslintrc.js",
    "directories": {
        "doc": "docs",
        "test": "test"
    },
    "devDependencies": {
        "@nomicfoundation/hardhat-ethers": "4.0.15",
        "@nomicfoundation/hardhat-ethers-chai-matchers": "3.0.1",
        "@nomicfoundation/hardhat-network-helpers": "3.0.11",
        "@nomicfoundation/hardhat-toolbox-mocha-ethers": "3.0.7",
        "@openzeppelin/contracts": "4.9.0",
        "@chainlink/contracts": "0.8.0",
        "@pythnetwork/pyth-sdk-solidity": "2.2.1",
        "chai": "5.3.3",
        "ethers": "6.14.0",
        "hardhat": "3.16.0"
    },
    "keywords": [],
    "author": "",
    "license": "ISC"
}
